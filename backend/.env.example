# Local development defaults are built into db.js; set these to override them.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bloodconnect

# Set true for Aiven MySQL. Keep certificate verification enabled.
DB_SSL=false
# Use exactly one CA variable when your Aiven service requires its CA certificate.
DB_SSL_CA_BASE64=
# DB_SSL_CA=

# Comma-separated origins are accepted. FRONTEND_ORIGIN is retained for compatibility.
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-local-secret
GOOGLE_CLIENT_ID=

# Optional integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
